# PlatformIO 빌드 산출물
.pio

# 에디터/도구가 자동 생성하는 파일 (사람이 손으로 고치지 않는 것들)
# .cache            : clangd 인덱스. 기계마다 다르고 빌드할 때마다 바뀐다.
# compile_commands  : pio run이 자동 생성. 절대 경로가 박혀 있어 남과 공유할 수 없다.
.cache/
compile_commands.json

.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# OS가 만드는 잡파일
.DS_Store
